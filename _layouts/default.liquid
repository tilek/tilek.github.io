<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.url == '/' %}{{ page.title | escape }} · {% endunless %}
      {{ site.title | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/skeleton/base.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/skeleton/skeleton.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/minimal.css' | relative_url }}">
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
  </head>
  <body>
    <div class="container">
      <header class="four columns">
        <h3>
          <a href="{{ '/' | relative_url }}">{{ site.title }}</a>
        </h3>
        <nav aria-label="Main navigation">
          <ul>
            <li>
              <a
                href="{{ '/' | relative_url }}"
                {% if page.url == '/' %}
                  aria-current="page"
                {% endif %}
                >about</a
              >
            </li>
            {% assign navigation = site.pages | sort: 'nav_order' %}
            {% for item in navigation %}
              {% if item.nav %}
                {% if item.dropdown %}
                  {% for child in item.children %}
                    {% unless child.title == 'divider' %}
                      <li>
                        <a href="{{ child.permalink }}">{{ child.title }}</a>
                      </li>
                    {% endunless %}
                  {% endfor %}
                {% else %}
                  <li>
                    <a
                      href="{{ item.url | relative_url }}"
                      {% if page.url == item.url %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- item.title -}}
                    </a>
                  </li>
                {% endif %}
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      </header>
      <main class="eleven columns offset-by-one" id="content">
        {{ content }}
        <footer>
          <small
            >© {{ 'now' | date: '%Y' }}
            {{ site.title }} · <a href="https://jekyllrb.com/">Jekyll</a> · <a href="https://github.com/dhg/Skeleton">Skeleton</a></small
          >
        </footer>
      </main>
    </div>
  </body>
</html>
