---
layout: default
---
<article>
  <h1>
    {% if page.url == '/' %}about{% else %}{{ page.title }}{% endif %}
  </h1>
  {% if page.subtitle %}
    <p>{{ page.subtitle }}</p>
  {% endif %}
  {% if page.profile.image %}
    <p><img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" width="180" alt="{{ site.title | escape }}"></p>
  {% endif %}
  {{ content }}
  {% if page.profile.more_info %}{{ page.profile.more_info }}{% endif %}
  {% if page.news and site.announcements.enabled %}
    <h2>news</h2>
    {% include news.liquid limit=true -%}
  {%- endif %}
  {% if page.latest_posts %}
    <h2>latest posts</h2>
    {% include latest_posts.liquid -%}
  {%- endif %}
  {% if page.selected_papers %}
    <h2>selected publications</h2>
    {% include selected_papers.liquid -%}
  {%- endif %}
</article>
