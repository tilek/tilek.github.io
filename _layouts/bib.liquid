---
---
<article id="{{ entry.key }}">
  <h3>
    {% if entry.html -%}
      <a href="{{ entry.html }}">{{ entry.title }}</a>
    {%- else -%}
      {{- entry.title -}}
    {%- endif %}
  </h3>
  <p>
    {% for author in entry.author_array -%}
      {{- author.first }}
      {{ author.last -}}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor %}
  </p>
  <p>
    <em>
      {{- entry.journal -}}
      {{- entry.booktitle -}}
      {{- entry.school -}}
    </em>
    {%- if entry.year %} · {{ entry.year }}{% endif %}
  </p>
  {% if entry.note %}
    <p>{{ entry.note }}</p>
  {% endif %}
  {% if entry.doi %}
    <p>
      <a href="https://doi.org/{{ entry.doi }}">DOI: {{ entry.doi }}</a>
    </p>
  {% endif %}
  {% if entry.abstract %}
    <details>
      <summary>Abstract</summary>
      <p>{{ entry.abstract }}</p>
    </details>
  {% endif %}
  {% if entry.bibtex_show %}
    <details>
      <summary>BibTeX</summary>
      <pre>{{ entry.bibtex | escape }}</pre>
    </details>
  {% endif %}
  {% assign link_types = 'html,pdf,supp,video,blog,code,poster,slides,website' | split: ',' %}
  <ul>
    {% for kind in link_types %}
      {% assign target = entry[kind] %}
      {% if target %}
        {% unless target contains '://' %}{% assign target = target | prepend: '/assets/pdf/' | relative_url %}{% endunless %}
        <li>
          <a href="{{ target }}">{{ kind }}</a>
        </li>
      {% endif %}
    {% endfor %}
    {% if entry.arxiv %}
      <li><a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a></li>
    {% endif %}
  </ul>
</article>
